rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin's Google account (uid). Only this account can see every player's records
    // and publish the shared range tables.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '8AdyXls5j7ZHzzzzpBLXKX2fQxz1';
    }
    // Instructor accounts (Google, verified email) allowed to record ring-practice games. Keep in step with RP_TEACHERS in index.html.
    function isTeacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['sho30647@gmail.com', 'kentonov@gmail.com'];
    }
    // Each account can only read/write its own data; the admin can read everyone's.
    match /data/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    // Account directory (name, email, first/last login) used by the admin view.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    // Range tables shared by every player (doc shared/ranges): everyone signed in reads, only the admin writes.
    match /shared/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      // Ring-practice games (shared/rpg_*): the instructors may add new ones (the admin can do anything via the rule above)
      allow create: if isTeacher() && doc.matches('rpg_.*') && request.resource.data.uid == request.auth.uid;
      // ... and edit / delete only the ones they saved themselves (docs saved before this field existed: admin only).
      allow update: if isTeacher() && doc.matches('rpg_.*') && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher() && doc.matches('rpg_.*') && resource.data.uid == request.auth.uid;
    }
  }
}
