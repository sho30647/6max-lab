rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each anonymous browser (uid from Firebase Auth) can only read/write its own data.
    match /data/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Range tables shared by every player (doc shared/ranges). Everyone signed in can read them;
    // writing needs a Google-linked account (the editor itself is behind the admin passcode in the UI).
    match /shared/{doc} {
      allow read: if request.auth != null;
      // (identities covers anonymous accounts that were later linked to Google, whose sign_in_provider can stay 'anonymous')
      allow write: if request.auth != null && 'google.com' in request.auth.token.firebase.identities;
    }
  }
}
